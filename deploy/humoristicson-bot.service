[Unit]
Description=Humoristicson Telegram bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/humoristicson-bot
EnvironmentFile=/etc/humoristicson-bot/bot.env
Environment=DB_PATH=/var/lib/humoristicson-bot/bot.sqlite3
Environment=PYTHONUNBUFFERED=1
StateDirectory=humoristicson-bot
StateDirectoryMode=0700
ExecStart=/opt/humoristicson-bot/.venv/bin/python /opt/humoristicson-bot/bot.py
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
